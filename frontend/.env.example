# Скопируйте этот файл в frontend/.env.local и подставьте свои значения.
# .env.local в Git не попадает (см. корневой .gitignore).

# Адрес backend (без /api на конце)
VITE_API_URL=http://127.0.0.1:8000

# true  — мок-ответы прямо в браузере (пока API отвечает 501)
# false — реальные запросы к backend (после мержа JWT-ветки Lead Dev)
VITE_USE_MOCKS=true
