# Скопируйте этот файл в frontend/.env.local и подставьте свои значения.
# .env.local в Git не попадает (см. корневой .gitignore).

# Адрес backend (без /api на конце)
VITE_API_URL=http://127.0.0.1:8000

# Спринт 3: backend готов, по умолчанию всё идёт в реальный API.
# true — мок-сервер авторизации и афиши прямо в браузере (демо без backend;
#        схема зала и бронирование в этом режиме недоступны — они только на реальном API).
VITE_USE_MOCKS=false

# true — только афиша и сеансы на моках (src/api/mockCinema.js), авторизация — реальная.
VITE_MOCK_CINEMA=false
